  "private": true,
  "description": "Plataforma de preparación para el Concurso de Méritos PGN 51-2026 (Asesor 1AS-19)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
