# --- Supabase (persistencia real + autenticación) ---
# Sin estas dos variables la app arranca en MODO LOCAL DE DEMOSTRACIÓN (datos solo en el navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Proveedor de IA (solo servidor; nunca se expone al navegador) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo configurable; consulte los modelos disponibles en docs.claude.com
ANTHROPIC_MODEL=

# Solo servidor: necesaria para que la ruta de IA lea documentos/fuentes con RAG en Supabase
SUPABASE_SERVICE_ROLE_KEY=
